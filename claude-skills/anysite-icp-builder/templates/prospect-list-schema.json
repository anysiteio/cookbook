{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnySite ICP Prospect List",
  "description": "Scored prospect list generated by AnySite ICP Builder",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "icp_version": {
          "type": "string",
          "description": "Version of ICP config used for scoring"
        },
        "generated_date": {
          "type": "string",
          "format": "date-time"
        },
        "total_prospects": {
          "type": "integer"
        },
        "score_distribution": {
          "type": "object",
          "properties": {
            "hot": { "type": "integer" },
            "warm": { "type": "integer" },
            "cool": { "type": "integer" },
            "low": { "type": "integer" }
          }
        }
      }
    },
    "prospects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "type": {
            "type": "string",
            "enum": ["person", "company"]
          },
          "name": {
            "type": "string"
          },
          "linkedin_url": {
            "type": "string",
            "format": "uri"
          },
          "company": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "industry": { "type": "string" },
              "employee_count": { "type": "integer" },
              "location": { "type": "string" },
              "linkedin_url": { "type": "string" }
            }
          },
          "contact": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "title": { "type": "string" },
              "seniority": { "type": "string" },
              "function": { "type": "string" },
              "linkedin_url": { "type": "string" }
            }
          },
          "scoring": {
            "type": "object",
            "properties": {
              "total_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "tier": {
                "type": "string",
                "enum": ["hot", "warm", "cool", "low"]
              },
              "breakdown": {
                "type": "object",
                "properties": {
                  "company_fit": { "type": "integer" },
                  "contact_fit": { "type": "integer" },
                  "engagement": { "type": "integer" }
                }
              },
              "match_reasons": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "personalization": {
            "type": "object",
            "properties": {
              "hooks": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Personalization hooks for outreach"
              },
              "recent_activity": {
                "type": "array",
                "items": { "type": "string" }
              },
              "mutual_connections": {
                "type": "integer"
              },
              "shared_interests": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "enrichment": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "phone": { "type": "string" },
              "twitter": { "type": "string" },
              "website": { "type": "string" }
            }
          }
        },
        "required": ["name", "linkedin_url", "scoring"]
      }
    }
  }
}
